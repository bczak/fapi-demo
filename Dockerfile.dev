FROM node:22-bookworm-slim

# Bun installs the dependencies and runs the scripts; Node still runs Vite, tsx, Vitest and the
# better-sqlite3 native addon.
COPY --from=oven/bun:1.4.3 /usr/local/bin/bun /usr/local/bin/bun

# better-sqlite3 compiles from source when no prebuilt binary is available (Bun does not bring node-gyp).
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g node-gyp

WORKDIR /app

# Only the manifests are copied here, so the dependency layer is cached until
# a package.json or the lockfile changes. The source is bind-mounted by compose.
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN bun install --frozen-lockfile
